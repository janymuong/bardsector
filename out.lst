     1                                  ; =============================================================================
     2                                  ;   TO BOOT OR NOT TO BOOT
     3                                  ;   a neural network that fits in a 512-byte boot sector and writes Shakespeare
     4                                  ;
     5                                  ;   No OS, no libc, no runtime. The BIOS loads this sector, and this sector
     6                                  ;   *is* the language model: ~220 bytes of 16-bit x86 + 243 bytes of 4-bit weights.
     7                                  ;
     8                                  ;   The net (trained by train.py on ~1 MB of Shakespeare):
     9                                  ;       h[k]     = ReLU( E1[prev][k] + E2[prev2][k] - 16 )       k = 0..5
    10                                  ;       logit[j] = sum_k h[k] * W[j][k]                          j = 27 symbols
    11                                  ;       next     = argmax_j ( logit[j] + noise )                 noise = PRNG
    12                                  ;
    13                                  ;   Type letters and the bard continues your thought.
    14                                  ;
    15                                  ;   build: nasm -f bin bardsector.asm -o bardsector.bin
    16                                  ; =============================================================================
    17                                  bits 16
    18                                  org 0x7C00
    19                                  
    20                                  H       equ 0x7E00              ; 6 bytes of hidden activations, just past the sector
    21                                  
    22                                  start:
    23 00000000 31C0                        xor     ax, ax
    24 00000002 8ED8                        mov     ds, ax
    25 00000004 8ED0                        mov     ss, ax
    26 00000006 BC007C                      mov     sp, 0x7C00
    27 00000009 FB                          sti                         ; hlt below needs interrupts on
    28 0000000A B003                        mov     al, 3               ; 80x25 text mode (also clears the screen)
    29 0000000C CD10                        int     0x10
    30                                  
    31 0000000E BE[CF00]                    mov     si, banner          ; title card
    32 00000011 31DB                        xor     bx, bx              ; page 0 for the BIOS teletype
    33 00000013 AC                      .b: lodsb
    34 00000014 84C0                        test    al, al
    35 00000016 7406                        jz      .go
    36 00000018 B40E                        mov     ah, 0x0E
    37 0000001A CD10                        int     0x10
    38 0000001C EBF5                        jmp     .b
    39                                  .go:
    40 0000001E 30E4                        xor     ah, ah              ; seed the PRNG from the BIOS tick counter
    41 00000020 CD1A                        int     0x1A
    42 00000022 89D7                        mov     di, dx              ; di = PRNG state for the whole program
    43 00000024 68[5C01]                    push    E2                  ; context lives on the stack as two row pointers:
    44 00000027 68[0B01]                    push    E1                  ;   top = E1 row of prev char, next = E2 row of the one before
    45                                  
    46                                  gen:
    47                                      ; ---- layer 1: embed the last two chars, add, ReLU ----------------------
    48 0000002A 5E                          pop     si                  ; si -> E1 row (3 bytes = 6 nibbles)
    49 0000002B 5B                          pop     bx                  ; bx -> E2 row
    50 0000002C BD007E                      mov     bp, H
    51 0000002F B103                        mov     cl, 3
    52 00000031 AC                      .h: lodsb
    53 00000032 D410                        aam     16                  ; al = low nibble, ah = high nibble
    54 00000034 89C2                        mov     dx, ax
    55 00000036 8A07                        mov     al, [bx]
    56 00000038 43                          inc     bx
    57 00000039 D410                        aam     16
    58 0000003B 00D0                        add     al, dl              ; nibbles are stored as w+8, so the sum has +16 in it
    59 0000003D 2C10                        sub     al, 16              ; subtract it; borrow means negative -> ReLU gives 0
    60 0000003F 7302                        jnc     .p
    61 00000041 30C0                        xor     al, al
    62 00000043 00F4                    .p: add     ah, dh
    63 00000045 80EC10                      sub     ah, 16
    64 00000048 7302                        jnc     .q
    65 0000004A 30E4                        xor     ah, ah
    66 0000004C 894600                  .q: mov     [bp], ax            ; h[2m], h[2m+1]
    67 0000004F 45                          inc     bp
    68 00000050 45                          inc     bp
    69 00000051 FEC9                        dec     cl
    70 00000053 75DC                        jnz     .h
    71 00000055 56                          push    si                  ; = E1 row + 3, used to shift the context below
    72                                  
    73                                      ; ---- layer 2: 27 logits, add noise, keep the best as (score<<5 | symbol) ----
    74 00000056 BE[AD01]                    mov     si, W
    75 00000059 B51A                        mov     ch, 26              ; symbol number, counts down; W rows are stored z..space
    76 0000005B 31D2                        xor     dx, dx              ; dx = best key so far
    77                                  .row:
    78 0000005D BB007E                      mov     bx, H
    79 00000060 31ED                        xor     bp, bp              ; bp = dot product accumulator
    80 00000062 B103                        mov     cl, 3
    81                                  .dot:
    82 00000064 AC                          lodsb
    83 00000065 D410                        aam     16
    84 00000067 50                          push    ax
    85 00000068 F627                        mul     byte [bx]           ; low nibble  * h[2m]
    86 0000006A 01C5                        add     bp, ax
    87 0000006C 58                          pop     ax
    88 0000006D 88E0                        mov     al, ah
    89 0000006F F66701                      mul     byte [bx+1]         ; high nibble * h[2m+1]
    90 00000072 01C5                        add     bp, ax
    91 00000074 83C302                      add     bx, 2
    92 00000077 FEC9                        dec     cl
    93 00000079 75E9                        jnz     .dot
    94 0000007B 69FF5562                    imul    di, di, 25173       ; PRNG: 16-bit LCG, full period
    95 0000007F 81C71936                    add     di, 13849
    96 00000083 89F8                        mov     ax, di
    97 00000085 C1E80A                      shr     ax, 10              ; 6 bits of noise: this is the "temperature"
    98 00000088 01E8                        add     ax, bp
    99 0000008A C1E005                      shl     ax, 5
   100 0000008D 08E8                        or      al, ch              ; low 5 bits carry the symbol
   101 0000008F 39D0                        cmp     ax, dx
   102 00000091 7602                        jbe     .no
   103 00000093 89C2                        mov     dx, ax
   104 00000095 FECD                    .no:dec     ch
   105 00000097 79C4                        jns     .row
   106                                  
   107 00000099 88D1                        mov     cl, dl
   108 0000009B 80E11F                      and     cl, 31              ; cl = the net's choice
   109                                  
   110                                      ; ---- keyboard: a typed key overrides the choice (folded to 5 bits) -----
   111 0000009E B401                        mov     ah, 1
   112 000000A0 CD16                        int     0x16
   113 000000A2 7408                        jz      .nk
   114 000000A4 30E4                        xor     ah, ah
   115 000000A6 CD16                        int     0x16
   116 000000A8 241F                        and     al, 31              ; space -> 0, a..z -> 1..26 (so do A..Z)
   117 000000AA 88C1                        mov     cl, al
   118                                  .nk:
   119                                      ; ---- print it -----------------------------------------------------------
   120 000000AC 88C8                        mov     al, cl
   121 000000AE 84C0                        test    al, al
   122 000000B0 7502                        jnz     .nz
   123 000000B2 B0C0                        mov     al, 0xC0            ; 0xC0 + 0x60 wraps to 0x20 = space
   124 000000B4 0460                    .nz:add     al, 0x60            ; 1..26 -> 'a'..'z'
   125 000000B6 B40E                        mov     ah, 0x0E
   126 000000B8 31DB                        xor     bx, bx
   127 000000BA CD10                        int     0x10
   128                                  
   129                                      ; ---- shift the context: prev2 <- prev, prev <- this --------------------
   130 000000BC 58                          pop     ax                  ; E1 row of prev, + 3
   131 000000BD 83C04E                      add     ax, E2 - E1 - 3     ; same row in the E2 table
   132 000000C0 50                          push    ax
   133 000000C1 88C8                        mov     al, cl
   134 000000C3 B403                        mov     ah, 3
   135 000000C5 F6E4                        mul     ah                  ; ax = 3 * symbol
   136 000000C7 05[0B01]                    add     ax, E1
   137 000000CA 50                          push    ax
   138 000000CB F4                          hlt                         ; sleep until the next timer tick (~55 ms): typewriter pace
   139 000000CC E95BFF                      jmp     gen
   140                                  
   141 000000CF 544F20424F4F542C20-     banner: db "TO BOOT, OR NOT TO BOOT:", 13, 10, 0
   141 000000D8 4F52204E4F5420544F-
   141 000000E1 20424F4F543A0D0A00 
   142                                  
   143 000000EA 00<rep 21h>                 times (510 - 243) - ($ - $$) db 0
   144                                  %include "weights.inc"
     1                              <1> ; generated by train.py - do not edit
     2                              <1> ; E1/E2: one row per symbol (0=space, 1..26=a..z), 3 bytes each.
     3                              <1> ; W: rows stored in REVERSE symbol order (z first) so the asm can count down.
     4                              <1> 

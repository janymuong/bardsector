     1                                  ; =============================================================================
     2                                  ;   TO BOOT OR NOT TO BOOT
     3                                  ;   a neural network that fits in a 512-byte boot sector and writes Shakespeare
     4                                  ;
     5                                  ;   No OS, no libc, no runtime. The BIOS loads this sector, and this sector
     6                                  ;   *is* the language model: ~270 bytes of 16-bit x86 + 243 bytes of 4-bit weights.
     7                                  ;
     8                                  ;   The net (trained by train.py on ~1 MB of Shakespeare):
     9                                  ;       h[k]     = ReLU( E1[prev][k] + E2[prev2][k] - 16 )       k = 0..5
    10                                  ;       logit[j] = sum_k h[k] * W[j][k]                          j = 27 symbols
    11                                  ;       next     = argmax_j ( logit[j] + noise )                 noise = PRNG, see below
    12                                  ;
    13                                  ;   Type letters and the bard continues your thought: the bard writes in cyan,
    14                                  ;   what you type shows in white, and the cursor is a block.
    15                                  ;
    16                                  ;   build: nasm -f bin bardsector.asm -o bardsector.bin
    17                                  ; =============================================================================
    18                                  bits 16
    19                                  org 0x7C00
    20                                  
    21                                  H       equ 0x7E00              ; 6 bytes of hidden activations, just past the sector
    22                                  
    23                                  start:
    24 00000000 31C0                        xor     ax, ax
    25 00000002 8ED8                        mov     ds, ax
    26 00000004 8ED0                        mov     ss, ax
    27 00000006 BC007C                      mov     sp, 0x7C00
    28 00000009 FB                          sti                         ; hlt below needs interrupts on
    29 0000000A B003                        mov     al, 3               ; 80x25 text mode (also clears the screen)
    30 0000000C CD10                        int     0x10
    31 0000000E B401                        mov     ah, 1               ; block cursor: scanlines 0..15
    32 00000010 B90F00                      mov     cx, 0x000F
    33 00000013 CD10                        int     0x10
    34                                  
    35 00000015 BE[ED00]                    mov     si, banner          ; title card, in yellow
    35          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    36 00000018 BB0E00                      mov     bx, 0x000E          ; bh = page 0, bl = colour attribute
    37 0000001B AC                      .b: lodsb
    38 0000001C 84C0                        test    al, al
    39 0000001E 7405                        jz      .go
    40 00000020 E8B800                      call    putc
    41 00000023 EBF6                        jmp     .b
    42                                  .go:
    43 00000025 30E4                        xor     ah, ah              ; seed the PRNG from the BIOS tick counter
    44 00000027 CD1A                        int     0x1A
    45 00000029 89D7                        mov     di, dx              ; di = PRNG state for the whole program
    46 0000002B 68[5C01]                    push    E2                  ; context lives on the stack as two row pointers:
    46          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    47 0000002E 68[0B01]                    push    E1                  ;   top = E1 row of prev char, next = E2 row of the one before
    47          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    48                                  
    49                                  gen:
    50                                      ; ---- layer 1: embed the last two chars, add, ReLU ----------------------
    51 00000031 5E                          pop     si                  ; si -> E1 row (3 bytes = 6 nibbles)
    52 00000032 5B                          pop     bx                  ; bx -> E2 row
    53 00000033 BD007E                      mov     bp, H
    54 00000036 B103                        mov     cl, 3
    55 00000038 AC                      .h: lodsb
    56 00000039 D410                        aam     16                  ; al = low nibble, ah = high nibble
    57 0000003B 89C2                        mov     dx, ax
    58 0000003D 8A07                        mov     al, [bx]
    59 0000003F 43                          inc     bx
    60 00000040 D410                        aam     16
    61 00000042 00D0                        add     al, dl              ; nibbles are stored as w+8, so the sum has +16 in it
    62 00000044 2C10                        sub     al, 16              ; subtract it; borrow means negative -> ReLU gives 0
    63 00000046 7302                        jnc     .p
    64 00000048 30C0                        xor     al, al
    65 0000004A 00F4                    .p: add     ah, dh
    66 0000004C 80EC10                      sub     ah, 16
    67 0000004F 7302                        jnc     .q
    68 00000051 30E4                        xor     ah, ah
    69 00000053 894600                  .q: mov     [bp], ax            ; h[2m], h[2m+1]
    70 00000056 45                          inc     bp
    71 00000057 45                          inc     bp
    72 00000058 FEC9                        dec     cl
    73 0000005A 75DC                        jnz     .h
    74 0000005C 56                          push    si                  ; = E1 row + 3, used to shift the context below
    75                                  
    76                                      ; ---- layer 2: 27 logits, add noise, keep the best as (score<<5 | symbol) ----
    77 0000005D BE[AD01]                    mov     si, W
    77          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    78 00000060 B51A                        mov     ch, 26              ; symbol number, counts down; W rows are stored z..space
    79 00000062 31D2                        xor     dx, dx              ; dx = best key so far
    80                                  .row:
    81 00000064 BB007E                      mov     bx, H
    82 00000067 69FF5562                    imul    di, di, 25173       ; PRNG: 16-bit LCG, full period
    83 0000006B 81C71936                    add     di, 13849
    84 0000006F 89FD                        mov     bp, di
    85 00000071 C1ED0A                      shr     bp, 10              ; bp = dot product accumulator, which starts as the noise
    86 00000074 89E8                        mov     ax, bp              ; r/1024 + r/2048 = 1.5 * r/1024, 0..94. This is the
    87 00000076 D1E8                        shr     ax, 1               ; "temperature": x1.0 repeats itself ("the th i his th it"),
    88 00000078 01C5                        add     bp, ax              ; x2.0 is pure gibberish, x1.5 mixes real words with inventions
    89 0000007A B103                        mov     cl, 3
    90                                  .dot:
    91 0000007C AC                          lodsb
    92 0000007D D410                        aam     16
    93 0000007F 50                          push    ax
    94 00000080 F627                        mul     byte [bx]           ; low nibble  * h[2m]
    95 00000082 01C5                        add     bp, ax
    96 00000084 58                          pop     ax
    97 00000085 88E0                        mov     al, ah
    98 00000087 F66701                      mul     byte [bx+1]         ; high nibble * h[2m+1]
    99 0000008A 01C5                        add     bp, ax
   100 0000008C 83C302                      add     bx, 2
   101 0000008F FEC9                        dec     cl
   102 00000091 75E9                        jnz     .dot
   103 00000093 95                          xchg    ax, bp              ; ax = noise + dot product
   104 00000094 C1E005                      shl     ax, 5
   105 00000097 08E8                        or      al, ch              ; low 5 bits carry the symbol
   106 00000099 39D0                        cmp     ax, dx
   107 0000009B 7602                        jbe     .no
   108 0000009D 89C2                        mov     dx, ax
   109 0000009F FECD                    .no:dec     ch
   110 000000A1 79C1                        jns     .row
   111                                  
   112 000000A3 88D1                        mov     cl, dl
   113 000000A5 80E11F                      and     cl, 31              ; cl = the net's choice
   114 000000A8 BB0B00                      mov     bx, 0x000B          ; its colour: bright cyan (bh = page 0)
   115                                  
   116                                      ; ---- keyboard: a typed key overrides the choice (folded to 5 bits) -----
   117 000000AB B401                        mov     ah, 1
   118 000000AD CD16                        int     0x16
   119 000000AF 740A                        jz      .nk
   120 000000B1 30E4                        xor     ah, ah
   121 000000B3 CD16                        int     0x16
   122 000000B5 241F                        and     al, 31              ; space -> 0, a..z -> 1..26 (so do A..Z)
   123 000000B7 88C1                        mov     cl, al
   124 000000B9 B30F                        mov     bl, 0x0F            ; typed text is bright white
   125                                  .nk:
   126                                      ; ---- shift the context: prev2 <- prev, prev <- this --------------------
   127 000000BB 58                          pop     ax                  ; E1 row of prev, + 3
   128 000000BC 83C04E                      add     ax, E2 - E1 - 3     ; same row in the E2 table
   129 000000BF 50                          push    ax
   130 000000C0 88C8                        mov     al, cl
   131 000000C2 B403                        mov     ah, 3
   132 000000C4 F6E4                        mul     ah                  ; ax = 3 * symbol
   133 000000C6 05[0B01]                    add     ax, E1
   133          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
   134 000000C9 50                          push    ax
   135                                  
   136                                      ; ---- print it -----------------------------------------------------------
   137 000000CA 88C8                        mov     al, cl
   138 000000CC 84C0                        test    al, al
   139 000000CE 7502                        jnz     .nz
   140 000000D0 B0C0                        mov     al, 0xC0            ; 0xC0 + 0x60 wraps to 0x20 = space
   141 000000D2 0460                    .nz:add     al, 0x60            ; 1..26 -> 'a'..'z'
   142 000000D4 E80400                      call    putc
   143 000000D7 F4                          hlt                         ; sleep until the next timer tick (~55 ms): typewriter pace
   144 000000D8 E956FF                      jmp     gen
   145                                  
   146                                  ; putc: print al in colour bl (bh = 0) and advance the cursor. Clobbers ax, cx.
   147                                  ; The BIOS teletype call keeps whatever colour a cell already has, so the colour is
   148                                  ; written first (AH=09 does not move the cursor) and the teletype call then moves it.
   149                                  ; Control characters (CR, LF) skip the colour write, or they would be drawn as glyphs.
   150                                  putc:
   151 000000DB 3C20                        cmp     al, ' '
   152 000000DD 7209                        jb      .t
   153 000000DF 50                          push    ax
   154 000000E0 B90100                      mov     cx, 1
   155 000000E3 B409                        mov     ah, 0x09
   156 000000E5 CD10                        int     0x10
   157 000000E7 58                          pop     ax
   158 000000E8 B40E                    .t: mov     ah, 0x0E
   159 000000EA CD10                        int     0x10
   160 000000EC C3                          ret
   161                                  
   162 000000ED 544F20424F4F542C20-     banner: db "TO BOOT, OR NOT TO BOOT:", 13, 10, 0
   162 000000F6 4F52204E4F5420544F-
   162 000000FF 20424F4F543A0D0A00 
